# Backend runtime (.env or hosting secret settings):
# APIFY_API_TOKEN=...
# OPENAI_API_KEY=...
# APIFY_ACTOR_ID=<verified separate COT Actor deployment>
# COT_ACTOR_MAX_CHARGE_USD=0.20
# COT_CONTACT_ACTOR_READY=true  # only after the contact Actor deployment/canary is verified
# COT_PIPELINE_API_KEY=<random shared secret>

# Scheduler runtime (backend/.env when using provided CLI):
# APIFY_API_TOKEN=...
# COT_PIPELINE_API_KEY=<same shared secret>
PIPELINE_LIVE_ENABLED=false
# PIPELINE_CONFIG=/absolute/path/to/config.json
