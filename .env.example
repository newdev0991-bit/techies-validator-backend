# === ENV for Render ===
PORT=10000
OPENAI_API_KEY=replace_with_your_openai_key
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
GOOGLE_CONTACT_FALLBACK=true
MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000
RATE_LIMIT_MAX=60
# COT Google Forms/Sheets exports use MM/DD/YYYY. Set DMY only if the source column is UK-formatted.
LEAD_DATE_ORDER=MDY
# Optional: e.g. "true" to enable verbose logs
DEBUG=false

# === Apify Configuration ===
APIFY_API_TOKEN=replace_with_your_apify_token
APIFY_ACTOR_ID=J8wBqFJa8GQo9RJ5J
APIFY_MAX_POSTS=10
APIFY_WAIT_SECS=120
APIFY_BATCH_WAIT_SECS=300
APIFY_ACTOR_CONTRACT=cot-data-batch-v1
COT_BATCH_SIZE=3
COT_ACTIVITY_WINDOW_DAYS=1
COT_BATCH_CACHE_TTL_MS=21600000
# Public logged-out HTTP: no Facebook account cookies are required or forwarded.

# --- Web contact recovery (ON by default) ----------------------------------
# Last-resort phone lookup for GOOD leads the Actor could not find a number for.
# Uses the Responses API web_search tool, which returns url_citation annotations;
# a number the model cannot point to in those citations is discarded rather than
# shown to a reviewer. Recovered numbers are always unverified candidates and can
# never carry a lead to READY on their own.
# To DISABLE, set this to one of: off | false | 0 | no  (case-insensitive).
# Any other value, or leaving it unset, leaves the capability ON.
# WEB_CONTACT_RECOVERY=off
WEB_SEARCH_MODEL=gpt-5.6
WEB_SEARCH_MAX_PER_BATCH=10
WEB_SEARCH_TIMEOUT_MS=60000

# --- Browsing verdict (ON by default) --------------------------------------
# Reaches the verdict WITH web evidence, scoped to the two spec rules a Facebook
# scrape cannot settle: is the address a commercial premises or a private
# residence, and does the business run 10+ sites / is it a chain. Both are
# auto-rejects in the spec that have never been enforceable here.
# Findings only bite when the model can cite the page in the search tool's own
# citation list, and the two rules are applied by code, not by the model.
# Falls back to the ordinary completion when off, on failure, or on a bad body.
# To DISABLE, set this to one of: off | false | 0 | no  (case-insensitive).
# Any other value, or leaving it unset, leaves the capability ON.
# WEB_VERDICT=off
WEB_VERDICT_MODEL=gpt-5.6
WEB_VERDICT_TIMEOUT_MS=90000
