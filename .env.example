# === ENV for Render ===
PORT=10000
OPENAI_API_KEY=replace_with_your_openai_key
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
GOOGLE_CONTACT_FALLBACK=true
MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000
RATE_LIMIT_MAX=60
# Transient OpenAI failures (429 rate-limit, 5xx) are retried with capped backoff,
# honouring any Retry-After header. An exhausted balance (429 insufficient_quota) is
# NOT retried -- it fails fast as OPENAI_QUOTA_EXHAUSTED so you top up.
OPENAI_MAX_RETRIES=2
# How many leads in a batch are analysed in parallel. Was effectively unbounded
# (= COT_BATCH_SIZE), which turned one rate-limit into a burst of simultaneous 429s.
ANALYZE_CONCURRENCY=3
# COT Google Forms/Sheets exports use MM/DD/YYYY. Set DMY only if the source column is UK-formatted.
LEAD_DATE_ORDER=MDY
# Optional: e.g. "true" to enable verbose logs
DEBUG=false

# === Apify Configuration ===
APIFY_API_TOKEN=replace_with_your_apify_token
APIFY_ACTOR_ID=J8wBqFJa8GQo9RJ5J
APIFY_MAX_POSTS=10
APIFY_WAIT_SECS=120
APIFY_BATCH_WAIT_SECS=300
APIFY_ACTOR_CONTRACT=cot-data-batch-v1
COT_BATCH_SIZE=3
COT_ACTIVITY_WINDOW_DAYS=1
COT_BATCH_CACHE_TTL_MS=21600000
# Public logged-out HTTP: no Facebook account cookies are required or forwarded.

# --- Web contact recovery (OFF by default) ---------------------------------
# Last-resort phone lookup for GOOD leads the Actor could not find a number for.
# Uses the Responses API web_search tool on WEB_SEARCH_MODEL, which costs many times
# a plain completion and fires once per GOOD lead with no upstream admission gate in
# the frontend batch path. OFF by default after the 2026-09-11 balance-exhaustion
# incident. To ENABLE, set this to one of: on | true | 1 | yes  (case-insensitive)
# -- and set a monthly spend cap at platform.openai.com/settings/organization/limits
# first. Any other value, or leaving it unset, leaves the capability OFF.
# WEB_CONTACT_RECOVERY=on
# Verified against this account on 2026-09-10. Model choice is not cosmetic: gpt-5.5
# and gpt-5.4 both named a source page they had never opened (gpt-5.4 opened no page at
# all and returned a different number), so their results are correctly discarded by the
# provenance check and the feature yields nothing. gpt-5.6-terra opened the page it
# cited. Change this only after checking a real lookup still passes that check.
WEB_SEARCH_MODEL=gpt-5.6-terra
WEB_SEARCH_MAX_PER_BATCH=10
WEB_SEARCH_TIMEOUT_MS=60000

# --- Browsing verdict (OFF by default) -------------------------------------
# Reaches the verdict WITH web evidence, scoped to the two spec rules a Facebook
# scrape cannot settle: is the address a commercial premises or a private
# residence, and does the business run 10+ sites / is it a chain.
# Runs a WEB_VERDICT_MODEL web_search call for EVERY lead that reaches the backend
# (the frontend batch path has no admission gate), so it is the single biggest
# cost lever. OFF by default after the 2026-09-11 balance-exhaustion incident.
# Falls back to the ordinary completion when off, on failure, or on a bad body.
# To ENABLE, set this to one of: on | true | 1 | yes  (case-insensitive) -- and set
# a monthly spend cap at platform.openai.com/settings/organization/limits first.
# Any other value, or leaving it unset, leaves the capability OFF.
# WEB_VERDICT=on
WEB_VERDICT_MODEL=gpt-5.6-terra
WEB_VERDICT_TIMEOUT_MS=90000
